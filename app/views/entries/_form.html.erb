<%= form_with(model: entry) do |form| %>
  <% if entry.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(entry.errors.count, "error") %> prohibited this entry from being saved:</h2>

      <ul>
        <% entry.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :kind, style: "display: block" %>
    <%= form.select :kind, Entry.kinds.keys.map { |k| [k.humanize, k] } %>
  </div>

  <div>
    <%= form.label :watched, style: "display: block" %>
    <%= form.check_box :watched %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
