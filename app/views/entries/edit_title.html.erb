<%= turbo_frame_tag dom_id(@entry, :title) do %>
  <%= form_with(model: @entry, url: update_title_entry_path(@entry)) do |form| %>
    <% if @entry.errors.any? %>
      <div style="color: red">
        <h2><%= pluralize(entry.errors.count, "error") %> prohibited this entry from being saved:</h2>

        <ul>
          <% @entry.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <wa-input name="entry[title]" value="<%= @entry.title %>" size="xs"></wa-input>
    </div>

    <div>
      <div class="wa-cluster">
        <wa-button appearance="filled" type="submit" variant="neutral" size="xs">Submit</wa-button>
        <wa-button appearance="filled" type="reset" variant="neutral" size="xs">Nevermind</wa-button>
      </div>
      <%# form.submit %>
    </div>
  <% end %>
<% end %>
